# Copy to `.env` for local `docker compose up`. Contains no secrets and neither should your copy —
# `.env` is gitignored.
#
# Values marked "platform-injected" are supplied automatically by the deploy pipeline in a real
# deployment. They appear here only because docker-compose has no platform to inject them.

# ---------------------------------------------------------------------------- platform-injected

# The exact catalog slug. The backend's expected JWT audience is `poc:<slug>`, built from this and
# never read from an incoming token.
POC_SLUG=local-dev

# Base URL of the platform API, reachable from the backend container. Signing keys are fetched
# from <this>/.well-known/jwks.json. Must be https in any real deployment.
PLATFORM_API_URL=http://host.docker.internal:8080

# The portal's bare origin — scheme, host, optional port. No path, no trailing slash, and never
# "*": the frontend refuses to start its bridge without a real origin to check messages against.
PORTAL_ORIGIN=http://localhost:4200

# ---------------------------------------------------------------------------- this POC's own

# NOT platform-injected. The pipeline supplies the slug, the API URL and the portal origin, but no
# issuer — see the integration guide §3. Must match the platform's configured `jwt.issuer`;
# `self-service-api` is its current default. Confirm before deploying to a new environment: a
# wrong value here rejects every token. Declared as a literal in poc.yaml for real deployments.
POC_EXPECTED_ISSUER=self-service-api

# Allows PLATFORM_API_URL to be plaintext http, and only against a loopback host. Local only —
# leave this unset anywhere real, or the backend will happily fetch signing keys over http.
POC_ALLOW_INSECURE_PLATFORM_URL=true

# ---------------------------------------------------------------------------- build-time

# A GitHub personal access token with `read:packages`, needed to install
# @yateesha-pappala/poc-bridge from GitHub Packages. Used as a BuildKit secret, so it is never
# written into an image layer. This is a real credential: export it in your shell, do not commit
# it, and do not paste it into a .env file that might get shared.
#
#   export NODE_AUTH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
NODE_AUTH_TOKEN=
