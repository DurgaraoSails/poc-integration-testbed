# `@yateesha-pappala/poc-bridge` is published to GitHub Packages, not npmjs.com, so the scope
# needs an explicit registry. Committing this file is safe: it contains no credential, only the
# name of the variable npm reads one from.
#
# Locally:  export NODE_AUTH_TOKEN=<a GitHub PAT with read:packages>
# In Docker: passed as a BuildKit secret, never an ARG — see apps/frontend/Dockerfile.
@yateesha-pappala:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
